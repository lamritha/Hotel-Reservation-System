<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1100.0"
            stylesheets="@../../css/app.css"
            fx:controller="com.hotelreservation.controller.kiosk.BookingSummaryController"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1">

    <top>
        <VBox spacing="5.0" styleClass="header">
            <children>
                <Label text="Booking Summary" styleClass="header-title" />
                <Label text="Review reservation details and final estimated charges before confirming"
                       styleClass="header-subtitle" />
            </children>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    styleClass="scroll-pane">
            <content>
                <StackPane>
                    <padding>
                        <Insets top="40" right="80" bottom="40" left="80" />
                    </padding>

                    <children>
                        <VBox spacing="18.0" maxWidth="780.0" styleClass="card">
                            <children>
                                <Label text="Review Reservation" styleClass="screen-title" />

                                <Label text="Please review the guest, stay, room, add-on, and pricing details before confirming."
                                       wrapText="true"
                                       style="-fx-font-size: 15px; -fx-text-fill: #4b5563;" />

                                <VBox spacing="10.0">
                                    <children>
                                        <Label fx:id="guestNameLabel"
                                               text="Guest:"
                                               style="-fx-font-size: 15px;" />

                                        <Label fx:id="contactLabel"
                                               text="Contact:"
                                               style="-fx-font-size: 15px;" />

                                        <Label fx:id="stayDatesLabel"
                                               text="Stay:"
                                               style="-fx-font-size: 15px;" />

                                        <Label fx:id="occupancyLabel"
                                               text="Occupancy:"
                                               style="-fx-font-size: 15px;" />

                                        <Label fx:id="roomPlanLabel"
                                               text="Room Plan:"
                                               wrapText="true"
                                               style="-fx-font-size: 15px;" />

                                        <Label fx:id="selectedAddOnsLabel"
                                               text="Selected Add-ons: None"
                                               wrapText="true"
                                               style="-fx-font-size: 15px;" />
                                    </children>
                                </VBox>

                                <Separator />

                                <Label text="Pricing Summary" styleClass="section-title" />

                                <VBox spacing="8.0">
                                    <children>
                                        <Label fx:id="roomTotalLabel" text="Room Total: CAD 0.00" />
                                        <Label fx:id="addOnTotalLabel" text="Add-ons Total: CAD 0.00" />
                                        <Label fx:id="subtotalLabel" text="Subtotal: CAD 0.00" />
                                        <Label fx:id="taxLabel" text="Tax (13%): CAD 0.00" />
                                        <Label fx:id="loyaltyStatusLabel" text="Loyalty Status: Not enrolled" />
                                        <Separator />
                                        <Label fx:id="finalTotalLabel"
                                               text="Final Total: CAD 0.00"
                                               style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2563eb;" />
                                    </children>
                                </VBox>

                                <Separator />

                                <Label text="Payment Information" styleClass="section-title" />

                                <Label fx:id="paymentNoticeLabel"
                                       text="Payment notice"
                                       wrapText="true"
                                       style="-fx-font-size: 14px; -fx-text-fill: #374151;" />

                                <HBox alignment="CENTER_RIGHT" spacing="15.0">
                                    <children>
                                        <Button text="Back"
                                                prefWidth="150.0"
                                                styleClass="secondary-button"
                                                onAction="#backToLoyaltyCheck" />

                                        <Button text="Confirm Reservation"
                                                prefWidth="240.0"
                                                styleClass="primary-button"
                                                onAction="#confirmReservation" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </StackPane>
            </content>
        </ScrollPane>
    </center>

    <left>
        <VBox prefWidth="200.0" alignment="TOP_CENTER" spacing="10.0" style="-fx-padding: 24 12 24 18;">
            <children>
                <Button fx:id="rulesButton"
                        text="Rules &amp; Regulations"
                        prefWidth="170.0"
                        wrapText="true"
                        styleClass="secondary-button"
                        onAction="#showRulesAndRegulations" />
            </children>
        </VBox>
    </left>

    <right>
        <Region prefWidth="200.0" />
    </right>

</BorderPane>
