<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1100.0"
            stylesheets="@../../css/app.css"
            fx:controller="com.hotelreservation.controller.kiosk.StayDatesController"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1">

    <top>
        <VBox spacing="5.0" styleClass="header">
            <children>
                <Label text="Stay Dates" styleClass="header-title" />
                <Label text="Select check-in and check-out dates for the reservation" styleClass="header-subtitle" />
            </children>
        </VBox>
    </top>

    <center>
        <StackPane>
            <padding>
                <Insets top="50" right="80" bottom="50" left="80" />
            </padding>

            <children>
                <VBox alignment="CENTER" maxWidth="650.0" spacing="22.0" styleClass="card">
                    <children>
                        <Label text="When will the guest stay?" styleClass="screen-title" />

                        <Label text="The kiosk validates the dates immediately before allowing the guest to continue."
                               wrapText="true"
                               style="-fx-font-size: 15px; -fx-text-fill: #4b5563;" />

                        <VBox spacing="12.0" maxWidth="320.0">
                            <children>
                                <Label text="Check-in Date" />
                                <DatePicker fx:id="checkInDatePicker"
                                            prefWidth="320.0"
                                            onAction="#validateDates" />

                                <Label text="Check-out Date" />
                                <DatePicker fx:id="checkOutDatePicker"
                                            prefWidth="320.0"
                                            onAction="#validateDates" />
                            </children>
                        </VBox>

                        <Label fx:id="validationLabel"
                               text="Date validation message"
                               style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2563eb;" />

                        <Label fx:id="nightsLabel"
                               text="Nights: 0"
                               style="-fx-font-size: 15px; -fx-text-fill: #111827;" />

                        <HBox alignment="CENTER" spacing="15.0">
                            <children>
                                <Button text="Back"
                                        prefWidth="150.0"
                                        styleClass="secondary-button"
                                        onAction="#backToOccupancy" />

                                <Button text="Continue to Guest Details"
                                        prefWidth="250.0"
                                        styleClass="primary-button"
                                        onAction="#continueToGuestDetails" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </StackPane>
    </center>

    <left>
        <VBox prefWidth="200.0" alignment="TOP_CENTER" spacing="10.0" style="-fx-padding: 24 12 24 18;">
            <children>
                <Button fx:id="rulesButton"
                        text="Rules &amp; Regulations"
                        prefWidth="170.0"
                        wrapText="true"
                        styleClass="secondary-button"
                        onAction="#showRulesAndRegulations" />
            </children>
        </VBox>
    </left>

    <right>
        <Region prefWidth="200.0" />
    </right>

</BorderPane>
