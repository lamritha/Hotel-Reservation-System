<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1100.0"
            stylesheets="@../../css/app.css"
            fx:controller="com.hotelreservation.controller.kiosk.RoomSelectionController"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1">

    <top>
        <VBox spacing="5.0" styleClass="header">
            <children>
                <Label text="Room Selection" styleClass="header-title" />
                <Label text="Choose room types and quantities based on guest occupancy" styleClass="header-subtitle" />
            </children>
        </VBox>
    </top>

    <center>
        <StackPane>
            <padding>
                <Insets top="30" right="60" bottom="30" left="60" />
            </padding>

            <children>
                <VBox spacing="20.0" maxWidth="850.0" styleClass="card">
                    <children>

                        <VBox spacing="8.0">
                            <children>
                                <Label text="Select Rooms" styleClass="screen-title" />

                                <Label fx:id="totalGuestsLabel"
                                       text="Total Guests: 0"
                                       style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #2563eb;" />

                                <Label text="The system suggests a room plan, but the guest can adjust room quantity using plus and minus buttons."
                                       wrapText="true"
                                       style="-fx-font-size: 14px; -fx-text-fill: #6b7280;" />
                            </children>
                        </VBox>

                        <GridPane hgap="20.0" vgap="16.0">
                            <children>

                                <Label text="Room Type"
                                       style="-fx-font-weight: bold;"
                                       GridPane.rowIndex="0"
                                       GridPane.columnIndex="0" />

                                <Label text="Capacity"
                                       style="-fx-font-weight: bold;"
                                       GridPane.rowIndex="0"
                                       GridPane.columnIndex="1" />

                                <Label text="Price / Night"
                                       style="-fx-font-weight: bold;"
                                       GridPane.rowIndex="0"
                                       GridPane.columnIndex="2" />

                                <Label text="Quantity"
                                       style="-fx-font-weight: bold;"
                                       GridPane.rowIndex="0"
                                       GridPane.columnIndex="3" />


                                <Label text="Single Room"
                                       GridPane.rowIndex="1"
                                       GridPane.columnIndex="0" />

                                <Label text="Up to 2 guests"
                                       GridPane.rowIndex="1"
                                       GridPane.columnIndex="1" />

                                <Label text="CAD 120"
                                       GridPane.rowIndex="1"
                                       GridPane.columnIndex="2" />

                                <HBox alignment="CENTER" spacing="10.0"
                                      GridPane.rowIndex="1"
                                      GridPane.columnIndex="3">
                                    <children>
                                        <Button text="-"
                                                prefWidth="40.0"
                                                styleClass="secondary-button"
                                                onAction="#decreaseSingle" />

                                        <Label fx:id="singleQtyLabel"
                                               text="0"
                                               prefWidth="35.0"
                                               style="-fx-font-size: 16px; -fx-font-weight: bold;"
                                               alignment="CENTER" />

                                        <Button text="+"
                                                prefWidth="40.0"
                                                styleClass="primary-button"
                                                onAction="#increaseSingle" />
                                    </children>
                                </HBox>


                                <Label text="Double Room"
                                       GridPane.rowIndex="2"
                                       GridPane.columnIndex="0" />

                                <Label text="Up to 4 guests"
                                       GridPane.rowIndex="2"
                                       GridPane.columnIndex="1" />

                                <Label text="CAD 180"
                                       GridPane.rowIndex="2"
                                       GridPane.columnIndex="2" />

                                <HBox alignment="CENTER" spacing="10.0"
                                      GridPane.rowIndex="2"
                                      GridPane.columnIndex="3">
                                    <children>
                                        <Button text="-"
                                                prefWidth="40.0"
                                                styleClass="secondary-button"
                                                onAction="#decreaseDouble" />

                                        <Label fx:id="doubleQtyLabel"
                                               text="0"
                                               prefWidth="35.0"
                                               style="-fx-font-size: 16px; -fx-font-weight: bold;"
                                               alignment="CENTER" />

                                        <Button text="+"
                                                prefWidth="40.0"
                                                styleClass="primary-button"
                                                onAction="#increaseDouble" />
                                    </children>
                                </HBox>


                                <Label text="Deluxe Room"
                                       GridPane.rowIndex="3"
                                       GridPane.columnIndex="0" />

                                <Label text="Up to 2 guests"
                                       GridPane.rowIndex="3"
                                       GridPane.columnIndex="1" />

                                <Label text="CAD 250"
                                       GridPane.rowIndex="3"
                                       GridPane.columnIndex="2" />

                                <HBox alignment="CENTER" spacing="10.0"
                                      GridPane.rowIndex="3"
                                      GridPane.columnIndex="3">
                                    <children>
                                        <Button text="-"
                                                prefWidth="40.0"
                                                styleClass="secondary-button"
                                                onAction="#decreaseDeluxe" />

                                        <Label fx:id="deluxeQtyLabel"
                                               text="0"
                                               prefWidth="35.0"
                                               style="-fx-font-size: 16px; -fx-font-weight: bold;"
                                               alignment="CENTER" />

                                        <Button text="+"
                                                prefWidth="40.0"
                                                styleClass="primary-button"
                                                onAction="#increaseDeluxe" />
                                    </children>
                                </HBox>


                                <Label text="Penthouse"
                                       GridPane.rowIndex="4"
                                       GridPane.columnIndex="0" />

                                <Label text="Up to 2 guests"
                                       GridPane.rowIndex="4"
                                       GridPane.columnIndex="1" />

                                <Label text="CAD 500"
                                       GridPane.rowIndex="4"
                                       GridPane.columnIndex="2" />

                                <HBox alignment="CENTER" spacing="10.0"
                                      GridPane.rowIndex="4"
                                      GridPane.columnIndex="3">
                                    <children>
                                        <Button text="-"
                                                prefWidth="40.0"
                                                styleClass="secondary-button"
                                                onAction="#decreasePenthouse" />

                                        <Label fx:id="penthouseQtyLabel"
                                               text="0"
                                               prefWidth="35.0"
                                               style="-fx-font-size: 16px; -fx-font-weight: bold;"
                                               alignment="CENTER" />

                                        <Button text="+"
                                                prefWidth="40.0"
                                                styleClass="primary-button"
                                                onAction="#increasePenthouse" />
                                    </children>
                                </HBox>

                            </children>
                        </GridPane>

                        <VBox spacing="8.0">
                            <children>
                                <Label fx:id="capacityLabel"
                                       text="Selected Room Capacity: 0"
                                       style="-fx-font-size: 15px; -fx-font-weight: bold;" />

                                <Label fx:id="roomPlanLabel"
                                       text="No rooms selected"
                                       wrapText="true"
                                       style="-fx-font-size: 14px; -fx-text-fill: #111827;" />

                                <Label fx:id="validationLabel"
                                       text="Room validation message"
                                       wrapText="true"
                                       style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2563eb;" />
                            </children>
                        </VBox>

                        <HBox alignment="CENTER_RIGHT" spacing="15.0">
                            <children>
                                <Button text="Back"
                                        prefWidth="150.0"
                                        styleClass="secondary-button"
                                        onAction="#backToGuestDetails" />

                                <Button text="Continue to Add-ons"
                                        prefWidth="220.0"
                                        styleClass="primary-button"
                                        onAction="#continueToAddOns" />
                            </children>
                        </HBox>

                    </children>
                </VBox>
            </children>
        </StackPane>
    </center>

    <left>
        <VBox prefWidth="200.0" alignment="TOP_CENTER" spacing="10.0" style="-fx-padding: 24 12 24 18;">
            <children>
                <Button fx:id="rulesButton"
                        text="Rules &amp; Regulations"
                        prefWidth="170.0"
                        wrapText="true"
                        styleClass="secondary-button"
                        onAction="#showRulesAndRegulations" />
            </children>
        </VBox>
    </left>

    <right>
        <Region prefWidth="200.0" />
    </right>

</BorderPane>
