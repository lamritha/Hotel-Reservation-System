<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1100.0"
            stylesheets="@../../css/app.css"
            fx:controller="com.hotelreservation.controller.kiosk.GuestDetailsController"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1">

    <top>
        <VBox spacing="5.0" styleClass="header">
            <children>
                <Label text="Guest Details" styleClass="header-title" />
                <Label text="Enter guest contact information for the reservation" styleClass="header-subtitle" />
            </children>
        </VBox>
    </top>

    <center>
        <VBox spacing="20.0" style="-fx-padding: 35;">
            <children>

                <VBox spacing="8.0">
                    <children>
                        <Label text="Guest Information" styleClass="screen-title" />
                        <Label text="Adults, children, and stay dates were collected in the previous steps. This screen only collects personal details."
                               wrapText="true"
                               style="-fx-font-size: 14px; -fx-text-fill: #6b7280;" />
                        <Label text="* Required fields"
                               styleClass="required-note" />
                    </children>
                </VBox>

                <GridPane hgap="20.0" vgap="16.0" styleClass="card">
                    <padding>
                        <Insets top="25" right="25" bottom="25" left="25" />
                    </padding>

                    <children>
                        <Label text="First Name *" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                        <VBox spacing="4.0"
                              GridPane.rowIndex="1"
                              GridPane.columnIndex="0">
                            <children>
                                <TextField fx:id="firstNameField"
                                           promptText="Enter first name"
                                           prefWidth="350" />
                                <Label fx:id="firstNameErrorLabel"
                                       text=""
                                       styleClass="field-error"
                                       managed="false"
                                       visible="false" />
                            </children>
                        </VBox>

                        <Label text="Last Name *" GridPane.rowIndex="0" GridPane.columnIndex="1" />
                        <VBox spacing="4.0"
                              GridPane.rowIndex="1"
                              GridPane.columnIndex="1">
                            <children>
                                <TextField fx:id="lastNameField"
                                           promptText="Enter last name"
                                           prefWidth="350" />
                                <Label fx:id="lastNameErrorLabel"
                                       text=""
                                       styleClass="field-error"
                                       managed="false"
                                       visible="false" />
                            </children>
                        </VBox>

                        <Label text="Email *" GridPane.rowIndex="2" GridPane.columnIndex="0" />
                        <VBox spacing="4.0"
                              GridPane.rowIndex="3"
                              GridPane.columnIndex="0">
                            <children>
                                <TextField fx:id="emailField"
                                           promptText="guest@email.com"
                                           prefWidth="350" />
                                <Label fx:id="emailErrorLabel"
                                       text=""
                                       styleClass="field-error"
                                       managed="false"
                                       visible="false" />
                            </children>
                        </VBox>

                        <Label text="Phone *" GridPane.rowIndex="2" GridPane.columnIndex="1" />
                        <VBox spacing="4.0"
                              GridPane.rowIndex="3"
                              GridPane.columnIndex="1">
                            <children>
                                <TextField fx:id="phoneField"
                                           promptText="Enter phone number"
                                           prefWidth="350" />
                                <Label fx:id="phoneErrorLabel"
                                       text=""
                                       styleClass="field-error"
                                       managed="false"
                                       visible="false" />
                            </children>
                        </VBox>

                        <Label text="Address *" GridPane.rowIndex="4" GridPane.columnIndex="0" />
                        <VBox spacing="4.0"
                              GridPane.rowIndex="5"
                              GridPane.columnIndex="0"
                              GridPane.columnSpan="2">
                            <children>
                                <TextArea fx:id="addressArea"
                                          promptText="Enter address"
                                          prefRowCount="4"
                                          prefWidth="720" />
                                <Label fx:id="addressErrorLabel"
                                       text=""
                                       styleClass="field-error"
                                       managed="false"
                                       visible="false" />
                            </children>
                        </VBox>
                    </children>
                </GridPane>

                <HBox alignment="CENTER_RIGHT" spacing="15.0">
                    <children>
                        <Button text="Back"
                                prefWidth="150.0"
                                styleClass="secondary-button"
                                onAction="#backToStayDates" />

                        <Button text="Continue to Room Selection"
                                prefWidth="280.0"
                                styleClass="primary-button"
                                onAction="#continueToRoomSelection" />
                    </children>
                </HBox>

            </children>
        </VBox>
    </center>

    <left>
        <VBox prefWidth="200.0" alignment="TOP_CENTER" spacing="10.0" style="-fx-padding: 24 12 24 18;">
            <children>
                <Button fx:id="rulesButton"
                        text="Rules &amp; Regulations"
                        prefWidth="170.0"
                        wrapText="true"
                        styleClass="secondary-button"
                        onAction="#showRulesAndRegulations" />
            </children>
        </VBox>
    </left>

    <right>
        <Region prefWidth="200.0" />
    </right>

</BorderPane>
