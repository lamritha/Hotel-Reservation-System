<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1100.0"
            stylesheets="@../../css/app.css"
            fx:controller="com.hotelreservation.controller.kiosk.FeedbackController"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1">

    <top>
        <VBox spacing="5.0" styleClass="header">
            <children>
                <Label text="Guest Feedback" styleClass="header-title" />
                <Label text="Submit feedback after checkout has been verified" styleClass="header-subtitle" />
            </children>
        </VBox>
    </top>

    <center>
        <StackPane>
            <padding>
                <Insets top="50" right="80" bottom="50" left="80" />
            </padding>

            <children>
                <VBox spacing="22.0" maxWidth="780.0" styleClass="card">
                    <children>

                        <Label text="How was your booking experience?" styleClass="screen-title" />

                        <Label text="This screen is available only after the system confirms that the guest has checked out."
                               wrapText="true"
                               style="-fx-font-size: 15px; -fx-text-fill: #4b5563;" />

                        <VBox spacing="10.0">
                            <children>
                                <Label text="Reservation ID" />

                                <Label fx:id="reservationIdLabel"
                                       text="RES-1001"
                                       style="-fx-font-size: 16px; -fx-font-weight: bold;" />

                                <Label text="Rating" />

                                <ComboBox fx:id="ratingComboBox"
                                          promptText="Select rating from 1 to 5"
                                          prefWidth="380.0" />

                                <Label text="Comment" />

                                <TextArea fx:id="commentArea"
                                          promptText="Write your feedback here..."
                                          prefRowCount="6"
                                          wrapText="true" />

                                <Label fx:id="sentimentLabel"
                                       text="Sentiment Tag: Pending Analysis"
                                       style="-fx-font-size: 14px; -fx-text-fill: #2563eb;" />
                            </children>
                        </VBox>

                    </children>
                </VBox>
            </children>
        </StackPane>
    </center>

    <bottom>
        <HBox alignment="CENTER" spacing="18.0" style="-fx-padding: 20;">
            <children>
                <Button text="Back"
                        prefWidth="180.0"
                        styleClass="secondary-button"
                        onAction="#backToFeedbackLookup" />

                <Button text="Submit Feedback"
                        prefWidth="260.0"
                        styleClass="primary-button"
                        onAction="#submitFeedback" />

                <Button text="Finish"
                        prefWidth="180.0"
                        styleClass="secondary-button"
                        onAction="#finishFeedback" />
            </children>
        </HBox>
    </bottom>

</BorderPane>