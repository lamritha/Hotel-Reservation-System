<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1100.0"
            stylesheets="@../../css/app.css"
            fx:controller="com.hotelreservation.controller.kiosk.OccupancyController"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1">

    <top>
        <VBox spacing="5.0" styleClass="header">
            <children>
                <Label text="Guest Occupancy" styleClass="header-title" />
                <Label text="Enter number of adults and children before selecting stay dates" styleClass="header-subtitle" />
            </children>
        </VBox>
    </top>

    <center>
        <StackPane>
            <padding>
                <Insets top="50" right="80" bottom="50" left="80" />
            </padding>

            <children>
                <VBox alignment="CENTER" maxWidth="650.0" spacing="22.0" styleClass="card">
                    <children>
                        <Label text="How many guests are staying?" styleClass="screen-title" />

                        <Label text="The kiosk first asks for adults and children so the system can validate room occupancy rules."
                               wrapText="true"
                               style="-fx-font-size: 15px; -fx-text-fill: #4b5563;" />

                        <VBox spacing="12.0" maxWidth="320.0">
                            <children>
                                <Label text="Number of Adults" />
                                <ComboBox fx:id="adultsComboBox"
                                          prefWidth="320.0"
                                          onAction="#updateTotalGuests" />

                                <Label text="Number of Children" />
                                <ComboBox fx:id="childrenComboBox"
                                          prefWidth="320.0"
                                          onAction="#updateTotalGuests" />
                            </children>
                        </VBox>

                        <Label fx:id="totalGuestsLabel"
                               text="Total Guests: 0"
                               style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2563eb;" />

                        <Label text="Occupancy rules: Single up to 2, Double up to 4, Deluxe and Penthouse up to 2."
                               wrapText="true"
                               style="-fx-font-size: 13px; -fx-text-fill: #6b7280;" />

                        <HBox alignment="CENTER" spacing="15.0">
                            <children>
                                <Button text="Back"
                                        prefWidth="150.0"
                                        styleClass="secondary-button"
                                        onAction="#backToWelcome" />

                                <Button text="Continue to Dates"
                                        prefWidth="220.0"
                                        styleClass="primary-button"
                                        onAction="#continueToStayDates" />
                            </children>
                        </HBox>

                    </children>
                </VBox>
            </children>
        </StackPane>
    </center>

    <left>
        <VBox prefWidth="200.0" alignment="TOP_CENTER" spacing="10.0" style="-fx-padding: 24 12 24 18;">
            <children>
                <Button fx:id="rulesButton"
                        text="Rules &amp; Regulations"
                        prefWidth="170.0"
                        wrapText="true"
                        styleClass="secondary-button"
                        onAction="#showRulesAndRegulations" />
            </children>
        </VBox>
    </left>

    <right>
        <Region prefWidth="200.0" />
    </right>

</BorderPane>
