<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1100.0"
            stylesheets="@../../css/app.css"
            fx:controller="com.hotelreservation.controller.admin.AdminDashboardController"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1">
    <top>
        <VBox spacing="5.0" styleClass="header">
            <children>
                <Label text="Admin Dashboard" styleClass="header-title"/>
                <Label text="Live operational overview from the hotel database"
                       styleClass="header-subtitle"/>
            </children>
        </VBox>
    </top>
    <left>
        <fx:include source="AdminSidebar.fxml"/>
    </left>
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER"
                    styleClass="scroll-pane">
            <content>
                <VBox spacing="18.0" style="-fx-padding: 26;">
                    <children>
                        <HBox spacing="15.0" alignment="CENTER_LEFT">
                            <children>
                                <Label fx:id="welcomeLabel"
                                       text="Welcome"
                                       styleClass="screen-title"/>
                                <Button text="Refresh"
                                        styleClass="primary-button"
                                        onAction="#refreshDashboard"/>
                            </children>
                        </HBox>

                        <GridPane hgap="14.0" vgap="14.0">
                            <children>
                                <VBox spacing="4.0" styleClass="card"
                                      prefWidth="180.0"
                                      GridPane.columnIndex="0"
                                      GridPane.rowIndex="0">
                                    <children>
                                        <Label text="Reservations"/>
                                        <Label fx:id="totalReservationsLabel"
                                               text="0"
                                               style="-fx-font-size: 26px; -fx-font-weight: bold;"/>
                                    </children>
                                </VBox>
                                <VBox spacing="4.0" styleClass="card"
                                      prefWidth="180.0"
                                      GridPane.columnIndex="1"
                                      GridPane.rowIndex="0">
                                    <children>
                                        <Label text="Checked In"/>
                                        <Label fx:id="checkedInLabel" text="0"
                                               style="-fx-font-size: 26px; -fx-font-weight: bold;"/>
                                    </children>
                                </VBox>
                                <VBox spacing="4.0" styleClass="card"
                                      prefWidth="180.0"
                                      GridPane.columnIndex="2"
                                      GridPane.rowIndex="0">
                                    <children>
                                        <Label text="Available Rooms"/>
                                        <Label fx:id="availableRoomsLabel" text="0"
                                               style="-fx-font-size: 26px; -fx-font-weight: bold;"/>
                                    </children>
                                </VBox>
                                <VBox spacing="4.0" styleClass="card"
                                      prefWidth="180.0"
                                      GridPane.columnIndex="3"
                                      GridPane.rowIndex="0">
                                    <children>
                                        <Label text="Occupied Rooms"/>
                                        <Label fx:id="occupiedRoomsLabel" text="0"
                                               style="-fx-font-size: 26px; -fx-font-weight: bold;"/>
                                    </children>
                                </VBox>
                                <VBox spacing="4.0" styleClass="card"
                                      prefWidth="180.0"
                                      GridPane.columnIndex="0"
                                      GridPane.rowIndex="1">
                                    <children>
                                        <Label text="Guests"/>
                                        <Label fx:id="totalGuestsLabel" text="0"
                                               style="-fx-font-size: 26px; -fx-font-weight: bold;"/>
                                    </children>
                                </VBox>
                                <VBox spacing="4.0" styleClass="card"
                                      prefWidth="180.0"
                                      GridPane.columnIndex="1"
                                      GridPane.rowIndex="1">
                                    <children>
                                        <Label text="Outstanding Bills"/>
                                        <Label fx:id="outstandingBillsLabel" text="0"
                                               style="-fx-font-size: 26px; -fx-font-weight: bold;"/>
                                    </children>
                                </VBox>
                                <VBox spacing="4.0" styleClass="card"
                                      prefWidth="180.0"
                                      GridPane.columnIndex="2"
                                      GridPane.rowIndex="1">
                                    <children>
                                        <Label text="Active Waitlist"/>
                                        <Label fx:id="waitlistLabel" text="0"
                                               style="-fx-font-size: 26px; -fx-font-weight: bold;"/>
                                    </children>
                                </VBox>
                                <VBox spacing="4.0" styleClass="card"
                                      prefWidth="180.0"
                                      GridPane.columnIndex="3"
                                      GridPane.rowIndex="1">
                                    <children>
                                        <Label text="Unread Alerts"/>
                                        <Label fx:id="notificationsLabel" text="0"
                                               style="-fx-font-size: 26px; -fx-font-weight: bold;"/>
                                    </children>
                                </VBox>
                            </children>
                        </GridPane>

                        <VBox spacing="8.0" styleClass="card">
                            <children>
                                <Label text="Payments Received Today"
                                       styleClass="section-title"/>
                                <Label fx:id="revenueLabel" text="CAD 0.00"
                                       style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
                            </children>
                        </VBox>

                        <VBox spacing="10.0" styleClass="card">
                            <children>
                                <Label text="Recent Reservations"
                                       styleClass="section-title"/>
                                <TableView fx:id="recentTable"
                                           prefHeight="230.0">
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                    <columns>
                                        <TableColumn fx:id="recentIdColumn"
                                                     text="Reservation"
                                                     prefWidth="130.0"/>
                                        <TableColumn fx:id="recentGuestColumn"
                                                     text="Guest"
                                                     prefWidth="240.0"/>
                                        <TableColumn fx:id="recentCheckInColumn"
                                                     text="Check-in"
                                                     prefWidth="150.0"/>
                                        <TableColumn fx:id="recentStatusColumn"
                                                     text="Status"
                                                     prefWidth="170.0"/>
                                    </columns>
                                </TableView>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
