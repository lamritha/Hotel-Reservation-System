<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1100.0"
            stylesheets="@../../css/app.css"
            fx:controller="com.hotelreservation.controller.admin.RoomManagementController"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1">
    <top>
        <VBox spacing="5.0" styleClass="header">
            <children>
                <Label text="Room Management" styleClass="header-title"/>
                <Label text="Search rooms and manage operational status"
                       styleClass="header-subtitle"/>
            </children>
        </VBox>
    </top>
    <left><fx:include source="AdminSidebar.fxml"/></left>
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER">
            <content>
                <VBox spacing="18.0" style="-fx-padding: 26;">
                    <children>
                        <HBox spacing="10.0" styleClass="card">
                            <children>
                                <TextField fx:id="searchField"
                                           promptText="Room number or floor"
                                           prefWidth="250.0"
                                           onAction="#searchRooms"/>
                                <ComboBox fx:id="typeFilter"
                                          promptText="Room type"
                                          prefWidth="150.0"/>
                                <ComboBox fx:id="statusFilter"
                                          promptText="Status"
                                          prefWidth="150.0"/>
                                <Button text="Search"
                                        styleClass="primary-button"
                                        onAction="#searchRooms"/>
                                <Button text="Clear"
                                        styleClass="secondary-button"
                                        onAction="#clearFilters"/>
                                <Label fx:id="resultLabel" text="0 room(s)"/>
                            </children>
                        </HBox>
                        <VBox spacing="10.0" styleClass="card">
                            <children>
                                <TableView fx:id="roomTable"
                                           prefHeight="410.0">
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                    <columns>
                                        <TableColumn fx:id="numberColumn"
                                                     text="Room"
                                                     prefWidth="100.0"/>
                                        <TableColumn fx:id="floorColumn"
                                                     text="Floor"
                                                     prefWidth="80.0"/>
                                        <TableColumn fx:id="typeColumn"
                                                     text="Type"
                                                     prefWidth="150.0"/>
                                        <TableColumn fx:id="priceColumn"
                                                     text="Base Price"
                                                     prefWidth="130.0"/>
                                        <TableColumn fx:id="capacityColumn"
                                                     text="Capacity"
                                                     prefWidth="100.0"/>
                                        <TableColumn fx:id="statusColumn"
                                                     text="Status"
                                                     prefWidth="150.0"/>
                                    </columns>
                                </TableView>
                                <HBox spacing="14.0" alignment="CENTER_RIGHT">
                                    <children>
                                        <Button fx:id="previousPageButton"
                                                text="Previous"
                                                prefWidth="100.0"
                                                styleClass="secondary-button"
                                                onAction="#previousPage"/>
                                        <Label fx:id="pageLabel"
                                               text="Page 1 of 1"
                                               style="-fx-font-weight: bold;"/>
                                        <Button fx:id="nextPageButton"
                                                text="Next"
                                                prefWidth="100.0"
                                                styleClass="secondary-button"
                                                onAction="#nextPage"/>
                                    </children>
                                </HBox>
                                <HBox spacing="10.0">
                                    <children>
                                        <Button fx:id="availableButton"
                                                text="Mark Available"
                                                styleClass="primary-button"
                                                onAction="#markAvailable"/>
                                        <Button fx:id="occupiedButton"
                                                text="Mark Occupied"
                                                styleClass="secondary-button"
                                                onAction="#markOccupied"/>
                                        <Button fx:id="maintenanceButton"
                                                text="Mark Maintenance"
                                                styleClass="secondary-button"
                                                onAction="#markMaintenance"/>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
