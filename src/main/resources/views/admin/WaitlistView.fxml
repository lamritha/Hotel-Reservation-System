<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1100.0"
            stylesheets="@../../css/app.css"
            fx:controller="com.hotelreservation.controller.admin.AdminNavigationController"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1">

    <top>
        <VBox spacing="5.0" styleClass="header">
            <children>
                <Label text="Waitlist Management" styleClass="header-title" />
                <Label text="Manage guests waiting for unavailable room types" styleClass="header-subtitle" />
            </children>
        </VBox>
    </top>

    <left>
        <VBox spacing="12.0" prefWidth="220.0" style="-fx-background-color: #111827; -fx-padding: 20;">
            <children>
                <Label text="Admin Menu"
                       style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;" />

                <Button text="Dashboard" prefWidth="180.0"
                        onAction="#openDashboard"
                        style="-fx-background-color: transparent; -fx-text-fill: #e5e7eb;" />

                <Button text="Reservations" prefWidth="180.0"
                        onAction="#openReservations"
                        style="-fx-background-color: transparent; -fx-text-fill: #e5e7eb;" />

                <Button text="Rooms" prefWidth="180.0"
                        onAction="#openRooms"
                        style="-fx-background-color: transparent; -fx-text-fill: #e5e7eb;" />

                <Button text="Guests" prefWidth="180.0"
                        onAction="#openGuests"
                        style="-fx-background-color: transparent; -fx-text-fill: #e5e7eb;" />

                <Button text="Billing and Payments" prefWidth="180.0"
                        onAction="#openBillingPayments"
                        style="-fx-background-color: transparent; -fx-text-fill: #e5e7eb;" />

                <Button text="Discounts" prefWidth="180.0"
                        onAction="#openDiscounts"
                        style="-fx-background-color: transparent; -fx-text-fill: #e5e7eb;" />

                <Button text="Loyalty" prefWidth="180.0"
                        onAction="#openLoyalty"
                        style="-fx-background-color: transparent; -fx-text-fill: #e5e7eb;" />

                <Button text="Waitlist" prefWidth="180.0"
                        onAction="#openWaitlist"
                        style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold;" />

                <Button text="Feedback" prefWidth="180.0"
                        onAction="#openFeedback"
                        style="-fx-background-color: transparent; -fx-text-fill: #e5e7eb;" />

                <Button text="Reports" prefWidth="180.0"
                        onAction="#openReports"
                        style="-fx-background-color: transparent; -fx-text-fill: #e5e7eb;" />

                <Button text="Notifications" prefWidth="180.0"
                        onAction="#openNotifications"
                        style="-fx-background-color: transparent; -fx-text-fill: #e5e7eb;" />

                <Button text="Logout" prefWidth="180.0"
                        onAction="#logout"
                        style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-font-weight: bold;" />
            </children>
        </VBox>
    </left>

    <center>
        <VBox spacing="22.0" style="-fx-padding: 30;">
            <children>

                <VBox spacing="6.0">
                    <children>
                        <Label text="Manage Waitlist Requests" styleClass="screen-title" />
                        <Label text="This screen connects to Waitlist, Guest, and RoomType. It also supports Observer notifications when rooms become available."
                               wrapText="true"
                               style="-fx-font-size: 14px; -fx-text-fill: #6b7280;" />
                    </children>
                </VBox>

                <HBox spacing="15.0" styleClass="card">
                    <children>
                        <TextField promptText="Search by guest name, waitlist ID, or room type" prefWidth="420.0" />
                        <ComboBox promptText="Desired room type" prefWidth="180.0" />
                        <ComboBox promptText="Notification status" prefWidth="180.0" />
                        <Button text="Search" prefWidth="120.0" styleClass="primary-button" />
                        <Button text="Clear" prefWidth="120.0" styleClass="secondary-button" />
                    </children>
                </HBox>

                <VBox spacing="12.0" styleClass="card">
                    <children>
                        <Label text="Waitlist Requests" styleClass="section-title" />

                        <GridPane hgap="18.0" vgap="12.0">
                            <children>
                                <Label text="Waitlist ID" style="-fx-font-weight: bold;" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                                <Label text="Guest" style="-fx-font-weight: bold;" GridPane.rowIndex="0" GridPane.columnIndex="1" />
                                <Label text="Desired Room" style="-fx-font-weight: bold;" GridPane.rowIndex="0" GridPane.columnIndex="2" />
                                <Label text="Check-in" style="-fx-font-weight: bold;" GridPane.rowIndex="0" GridPane.columnIndex="3" />
                                <Label text="Check-out" style="-fx-font-weight: bold;" GridPane.rowIndex="0" GridPane.columnIndex="4" />
                                <Label text="Guests" style="-fx-font-weight: bold;" GridPane.rowIndex="0" GridPane.columnIndex="5" />
                                <Label text="Notified" style="-fx-font-weight: bold;" GridPane.rowIndex="0" GridPane.columnIndex="6" />

                                <Label text="WAIT-021" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                                <Label text="Nina Patel" GridPane.rowIndex="1" GridPane.columnIndex="1" />
                                <Label text="Deluxe" GridPane.rowIndex="1" GridPane.columnIndex="2" />
                                <Label text="July 18, 2026" GridPane.rowIndex="1" GridPane.columnIndex="3" />
                                <Label text="July 20, 2026" GridPane.rowIndex="1" GridPane.columnIndex="4" />
                                <Label text="2 Adults" GridPane.rowIndex="1" GridPane.columnIndex="5" />
                                <Label text="No" style="-fx-text-fill: orange;" GridPane.rowIndex="1" GridPane.columnIndex="6" />

                                <Label text="WAIT-022" GridPane.rowIndex="2" GridPane.columnIndex="0" />
                                <Label text="Omar Khan" GridPane.rowIndex="2" GridPane.columnIndex="1" />
                                <Label text="Penthouse" GridPane.rowIndex="2" GridPane.columnIndex="2" />
                                <Label text="July 22, 2026" GridPane.rowIndex="2" GridPane.columnIndex="3" />
                                <Label text="July 24, 2026" GridPane.rowIndex="2" GridPane.columnIndex="4" />
                                <Label text="2 Adults" GridPane.rowIndex="2" GridPane.columnIndex="5" />
                                <Label text="Yes" style="-fx-text-fill: green;" GridPane.rowIndex="2" GridPane.columnIndex="6" />

                                <Label text="WAIT-023" GridPane.rowIndex="3" GridPane.columnIndex="0" />
                                <Label text="Emma Wilson" GridPane.rowIndex="3" GridPane.columnIndex="1" />
                                <Label text="Double" GridPane.rowIndex="3" GridPane.columnIndex="2" />
                                <Label text="July 25, 2026" GridPane.rowIndex="3" GridPane.columnIndex="3" />
                                <Label text="July 28, 2026" GridPane.rowIndex="3" GridPane.columnIndex="4" />
                                <Label text="2 Adults, 2 Children" GridPane.rowIndex="3" GridPane.columnIndex="5" />
                                <Label text="No" style="-fx-text-fill: orange;" GridPane.rowIndex="3" GridPane.columnIndex="6" />
                            </children>
                        </GridPane>
                    </children>
                </VBox>

                <GridPane hgap="20.0" vgap="20.0">
                    <children>

                        <VBox spacing="10.0" styleClass="card" prefWidth="390.0" GridPane.rowIndex="0" GridPane.columnIndex="0">
                            <children>
                                <Label text="Selected Waitlist Request" styleClass="section-title" />
                                <Label text="Waitlist ID: WAIT-021" />
                                <Label text="Guest: Nina Patel" />
                                <Label text="Desired Room Type: Deluxe" />
                                <Label text="Status: Waiting for available room" />
                            </children>
                        </VBox>

                        <VBox spacing="10.0" styleClass="card" prefWidth="390.0" GridPane.rowIndex="0" GridPane.columnIndex="1">
                            <children>
                                <Label text="Waitlist Actions" styleClass="section-title" />
                                <Button text="Notify Guest" prefWidth="200.0" styleClass="primary-button" />
                                <Button text="Assign Available Room" prefWidth="220.0" styleClass="primary-button" />
                                <Button text="Remove From Waitlist" prefWidth="220.0" styleClass="secondary-button" />
                            </children>
                        </VBox>

                    </children>
                </GridPane>

            </children>
        </VBox>
    </center>

</BorderPane>