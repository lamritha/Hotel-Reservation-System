<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1100.0"
            stylesheets="@../../css/app.css"
            fx:controller="com.hotelreservation.controller.admin.WaitlistController"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1">
    <top>
        <VBox spacing="5.0" styleClass="header">
            <children>
                <Label text="Waitlist Management" styleClass="header-title"/>
                <Label text="Capture unavailable requests and convert matches into reservations"
                       styleClass="header-subtitle"/>
            </children>
        </VBox>
    </top>
    <left><fx:include source="AdminSidebar.fxml"/></left>
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER">
            <content>
                <VBox spacing="16.0" style="-fx-padding: 24;">
                    <children>
                        <HBox spacing="10.0" styleClass="card">
                            <children>
                                <TextField fx:id="searchField"
                                           promptText="Guest, email, or phone"
                                           prefWidth="340.0"
                                           onAction="#searchEntries"/>
                                <ComboBox fx:id="statusFilter"
                                          promptText="Status"
                                          prefWidth="150.0"/>
                                <Button text="Search"
                                        styleClass="primary-button"
                                        onAction="#searchEntries"/>
                                <Button text="Clear"
                                        styleClass="secondary-button"
                                        onAction="#clearFilters"/>
                                <Label fx:id="resultLabel" text="0 waitlist entries"/>
                            </children>
                        </HBox>

                        <VBox spacing="8.0" styleClass="card">
                            <children>
                                <TableView fx:id="waitlistTable" prefHeight="255.0">
                                    <columns>
                                        <TableColumn fx:id="idColumn" text="ID" prefWidth="90.0"/>
                                        <TableColumn fx:id="guestColumn" text="Guest" prefWidth="170.0"/>
                                        <TableColumn fx:id="roomTypeColumn" text="Room Type" prefWidth="120.0"/>
                                        <TableColumn fx:id="checkInColumn" text="Check-in" prefWidth="110.0"/>
                                        <TableColumn fx:id="checkOutColumn" text="Check-out" prefWidth="110.0"/>
                                        <TableColumn fx:id="occupancyColumn" text="Occupancy" prefWidth="180.0"/>
                                        <TableColumn fx:id="entryStatusColumn" text="Status" prefWidth="110.0"/>
                                    </columns>
                                </TableView>
                                <HBox spacing="14.0" alignment="CENTER_RIGHT">
                                    <children>
                                        <Button fx:id="previousPageButton"
                                                text="Previous"
                                                prefWidth="100.0"
                                                styleClass="secondary-button"
                                                onAction="#previousPage"/>
                                        <Label fx:id="pageLabel"
                                               text="Page 1 of 1"
                                               style="-fx-font-weight: bold;"/>
                                        <Button fx:id="nextPageButton"
                                                text="Next"
                                                prefWidth="100.0"
                                                styleClass="secondary-button"
                                                onAction="#nextPage"/>
                                    </children>
                                </HBox>
                                <HBox spacing="10.0">
                                    <children>
                                        <Button fx:id="convertButton"
                                                text="Convert to Reservation"
                                                styleClass="primary-button"
                                                onAction="#convertEntry"/>
                                        <Button fx:id="cancelButton"
                                                text="Cancel Entry"
                                                styleClass="secondary-button"
                                                onAction="#cancelEntry"/>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <VBox spacing="10.0" styleClass="card">
                            <children>
                                <Label text="Add Guest to Waitlist"
                                       styleClass="section-title"/>
                                <Label text="* Required fields"
                                       styleClass="required-note"/>
                                <GridPane hgap="12.0" vgap="9.0">
                                    <children>
                                        <Label text="First Name *" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                                        <TextField fx:id="firstNameField" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                                        <Label text="Last Name *" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                                        <TextField fx:id="lastNameField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                                        <Label text="Email *" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                                        <TextField fx:id="emailField" prefWidth="230.0" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                                        <Label text="Phone *" GridPane.rowIndex="0" GridPane.columnIndex="3"/>
                                        <TextField fx:id="phoneField" GridPane.rowIndex="1" GridPane.columnIndex="3"/>

                                        <Label text="Address *" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                                        <TextArea fx:id="addressArea"
                                                  prefRowCount="2"
                                                  prefWidth="290.0"
                                                  GridPane.rowIndex="3"
                                                  GridPane.columnIndex="0"
                                                  GridPane.columnSpan="2"/>
                                        <Label text="Room Type *" GridPane.rowIndex="2" GridPane.columnIndex="2"/>
                                        <ComboBox fx:id="roomTypeComboBox"
                                                  prefWidth="170.0"
                                                  GridPane.rowIndex="3"
                                                  GridPane.columnIndex="2"/>
                                        <Label text="Adults *" GridPane.rowIndex="2" GridPane.columnIndex="3"/>
                                        <Spinner fx:id="adultsSpinner"
                                                 prefWidth="100.0"
                                                 GridPane.rowIndex="3"
                                                 GridPane.columnIndex="3"/>

                                        <Label text="Check-in *" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                                        <DatePicker fx:id="checkInPicker" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                                        <Label text="Check-out *" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                                        <DatePicker fx:id="checkOutPicker" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
                                        <Label text="Children" GridPane.rowIndex="4" GridPane.columnIndex="2"/>
                                        <Spinner fx:id="childrenSpinner"
                                                 prefWidth="100.0"
                                                 GridPane.rowIndex="5"
                                                 GridPane.columnIndex="2"/>
                                        <Button text="Add to Waitlist"
                                                styleClass="primary-button"
                                                onAction="#addEntry"
                                                GridPane.rowIndex="5"
                                                GridPane.columnIndex="3"/>
                                    </children>
                                </GridPane>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
