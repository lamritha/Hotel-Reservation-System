<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0"
            prefWidth="1100.0"
            stylesheets="@../../css/app.css"
            fx:controller="com.hotelreservation.controller.admin.ReservationManagementController"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1">

    <top>
        <VBox spacing="5.0" styleClass="header">
            <children>
                <Label text="Reservation Management"
                       styleClass="header-title"/>

                <Label text="Search, review, create, modify, and cancel hotel reservations"
                       styleClass="header-subtitle"/>
            </children>
        </VBox>
    </top>

    <left>
        <fx:include source="AdminSidebar.fxml"/>
    </left>

    <center>
        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    styleClass="scroll-pane">
            <content>
                <VBox spacing="22.0"
                      style="-fx-padding: 30;">
                    <children>

                        <VBox spacing="6.0">
                            <children>
                                <Label text="Manage Reservations"
                                       styleClass="screen-title"/>

                                <Label text="Search using a reservation ID, guest name, email, phone number, status, or overlapping stay dates."
                                       wrapText="true"
                                       style="-fx-font-size: 14px; -fx-text-fill: #6b7280;"/>
                            </children>
                        </VBox>

                        <VBox spacing="14.0"
                              styleClass="card">
                            <children>

                                <HBox spacing="12.0"
                                      alignment="CENTER_LEFT">
                                    <children>
                                        <TextField fx:id="searchField"
                                                   promptText="Reservation ID, guest name, email, or phone"
                                                   prefWidth="380.0"
                                                   onAction="#searchReservations"/>

                                        <ComboBox fx:id="statusFilter"
                                                  promptText="All statuses"
                                                  prefWidth="180.0"/>

                                        <Button text="Search"
                                                prefWidth="110.0"
                                                styleClass="primary-button"
                                                onAction="#searchReservations"/>

                                        <Button text="Clear"
                                                prefWidth="110.0"
                                                styleClass="secondary-button"
                                                onAction="#clearFilters"/>
                                    </children>
                                </HBox>

                                <HBox spacing="12.0"
                                      alignment="CENTER_LEFT">
                                    <children>
                                        <Label text="Stay overlaps:"
                                               style="-fx-font-weight: bold;"/>

                                        <Label text="From"/>

                                        <DatePicker fx:id="dateFromPicker"
                                                    prefWidth="180.0"/>

                                        <Label text="To"/>

                                        <DatePicker fx:id="dateToPicker"
                                                    prefWidth="180.0"/>
                                    </children>
                                </HBox>

                            </children>
                        </VBox>

                        <VBox spacing="12.0"
                              styleClass="card">
                            <children>
                                <Label text="Reservation Results"
                                       styleClass="section-title"/>

                                <TableView fx:id="reservationTable"
                                           prefHeight="350.0"
                                           columnResizePolicy="CONSTRAINED_RESIZE_POLICY">
                                    <columns>
                                        <TableColumn fx:id="reservationIdColumn"
                                                     text="ID"
                                                     prefWidth="85.0"/>

                                        <TableColumn fx:id="guestColumn"
                                                     text="Guest"
                                                     prefWidth="140.0"/>

                                        <TableColumn fx:id="phoneColumn"
                                                     text="Phone"
                                                     prefWidth="120.0"/>

                                        <TableColumn fx:id="roomsColumn"
                                                     text="Rooms"
                                                     prefWidth="185.0"/>

                                        <TableColumn fx:id="checkInColumn"
                                                     text="Check-in"
                                                     prefWidth="100.0"/>

                                        <TableColumn fx:id="checkOutColumn"
                                                     text="Check-out"
                                                     prefWidth="100.0"/>

                                        <TableColumn fx:id="statusColumn"
                                                     text="Status"
                                                     prefWidth="110.0"/>
                                    </columns>
                                </TableView>

                                <HBox spacing="14.0"
                                      alignment="CENTER_RIGHT">
                                    <children>
                                        <Label fx:id="resultCountLabel"
                                               text="0 reservation(s) found"
                                               style="-fx-text-fill: #6b7280;"/>

                                        <Button fx:id="previousPageButton"
                                                text="Previous"
                                                prefWidth="100.0"
                                                styleClass="secondary-button"
                                                onAction="#previousPage"/>

                                        <Label fx:id="pageLabel"
                                               text="Page 1 of 1"
                                               style="-fx-font-weight: bold;"/>

                                        <Button fx:id="nextPageButton"
                                                text="Next"
                                                prefWidth="100.0"
                                                styleClass="secondary-button"
                                                onAction="#nextPage"/>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <HBox spacing="12.0"
                              styleClass="card"
                              alignment="CENTER_LEFT">
                            <children>
                                <Button fx:id="viewDetailsButton"
                                        text="View Details"
                                        prefWidth="130.0"
                                        styleClass="primary-button"
                                        onAction="#viewDetails"/>

                                <Button text="New Phone Reservation"
                                        prefWidth="190.0"
                                        styleClass="secondary-button"
                                        onAction="#createPhoneReservation"/>

                                <Button fx:id="modifyButton"
                                        text="Modify"
                                        prefWidth="110.0"
                                        styleClass="secondary-button"
                                        onAction="#modifyReservation"/>

                                <Button fx:id="cancelButton"
                                        prefWidth="110.0"
                                        styleClass="secondary-button"
                                        mnemonicParsing="false"
                                        onAction="#cancelReservation"
                                        text="Cancel" />

                                <Button fx:id="checkInButton"
                                        text="Check In"
                                        prefWidth="110.0"
                                        styleClass="secondary-button"
                                        onAction="#checkInReservation"/>

                                <Button fx:id="checkOutButton"
                                        text="Check Out"
                                        prefWidth="110.0"
                                        styleClass="secondary-button"
                                        onAction="#checkOutReservation"/>
                            </children>
                        </HBox>

                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>
