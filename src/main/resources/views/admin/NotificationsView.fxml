<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1100.0"
            stylesheets="@../../css/app.css"
            fx:controller="com.hotelreservation.controller.admin.NotificationsController"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1">
    <top>
        <VBox spacing="5.0" styleClass="header">
            <children>
                <Label text="Notifications" styleClass="header-title"/>
                <Label text="Observer-generated room availability and waitlist alerts"
                       styleClass="header-subtitle"/>
            </children>
        </VBox>
    </top>
    <left><fx:include source="AdminSidebar.fxml"/></left>
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER">
            <content>
                <VBox spacing="16.0" style="-fx-padding: 24;">
                    <children>
                        <HBox spacing="10.0" styleClass="card">
                            <children>
                                <TextField fx:id="searchField"
                                           promptText="Search message"
                                           prefWidth="320.0"
                                           onAction="#searchNotifications"/>
                                <ComboBox fx:id="typeFilter"
                                          promptText="Type"
                                          prefWidth="170.0"/>
                                <ComboBox fx:id="statusFilter"
                                          prefWidth="120.0"/>
                                <Button text="Search"
                                        styleClass="primary-button"
                                        onAction="#searchNotifications"/>
                                <Button text="Clear"
                                        styleClass="secondary-button"
                                        onAction="#clearFilters"/>
                                <Label fx:id="resultLabel" text="0 notification(s)"/>
                            </children>
                        </HBox>
                        <VBox spacing="10.0" styleClass="card">
                            <children>
                                <TableView fx:id="notificationTable"
                                           prefHeight="500.0"
                                           columnResizePolicy="CONSTRAINED_RESIZE_POLICY">
                                    <columns>
                                        <TableColumn fx:id="idColumn" text="ID" prefWidth="90.0"/>
                                        <TableColumn fx:id="typeColumn" text="Type" prefWidth="150.0"/>
                                        <TableColumn fx:id="messageColumn" text="Message" prefWidth="450.0"/>
                                        <TableColumn fx:id="createdColumn" text="Created" prefWidth="180.0"/>
                                        <TableColumn fx:id="statusColumn" text="Status" prefWidth="100.0"/>
                                    </columns>
                                </TableView>
                                <HBox spacing="14.0" alignment="CENTER_RIGHT">
                                    <children>
                                        <Button fx:id="previousPageButton"
                                                text="Previous"
                                                prefWidth="100.0"
                                                styleClass="secondary-button"
                                                onAction="#previousPage"/>
                                        <Label fx:id="pageLabel"
                                               text="Page 1 of 1"
                                               style="-fx-font-weight: bold;"/>
                                        <Button fx:id="nextPageButton"
                                                text="Next"
                                                prefWidth="100.0"
                                                styleClass="secondary-button"
                                                onAction="#nextPage"/>
                                    </children>
                                </HBox>
                                <HBox spacing="10.0">
                                    <children>
                                        <Button fx:id="markReadButton"
                                                text="Mark as Read"
                                                styleClass="primary-button"
                                                onAction="#markRead"/>
                                        <Button fx:id="archiveButton"
                                                text="Archive"
                                                styleClass="secondary-button"
                                                onAction="#archive"/>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
