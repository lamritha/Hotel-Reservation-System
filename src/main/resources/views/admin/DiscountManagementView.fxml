<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1100.0"
            stylesheets="@../../css/app.css"
            fx:controller="com.hotelreservation.controller.admin.DiscountManagementController"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1">
    <top>
        <VBox spacing="5.0" styleClass="header">
            <children>
                <Label text="Discount Management" styleClass="header-title"/>
                <Label text="Role-enforced discounts: Admin 15%, Manager 30%"
                       styleClass="header-subtitle"/>
            </children>
        </VBox>
    </top>
    <left><fx:include source="AdminSidebar.fxml"/></left>
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER">
            <content>
                <VBox spacing="16.0" style="-fx-padding: 24;">
                    <children>
                        <HBox spacing="10.0" styleClass="card">
                            <children>
                                <TextField fx:id="searchField"
                                           promptText="Reservation or guest"
                                           prefWidth="350.0"
                                           onAction="#searchBills"/>
                                <Button text="Search"
                                        styleClass="primary-button"
                                        onAction="#searchBills"/>
                                <Button text="Clear"
                                        styleClass="secondary-button"
                                        onAction="#clearSearch"/>
                                <Label fx:id="resultLabel" text="0 bill(s)"/>
                                <Label fx:id="capLabel"
                                       text="Your role cap"
                                       style="-fx-font-weight: bold;"/>
                            </children>
                        </HBox>
                        <VBox spacing="8.0" styleClass="card">
                            <children>
                                <TableView fx:id="billingTable"
                                           prefHeight="260.0"
                                           columnResizePolicy="CONSTRAINED_RESIZE_POLICY">
                                    <columns>
                                        <TableColumn fx:id="reservationColumn" text="Reservation" prefWidth="120.0"/>
                                        <TableColumn fx:id="guestColumn" text="Guest" prefWidth="190.0"/>
                                        <TableColumn fx:id="totalColumn" text="Total" prefWidth="110.0"/>
                                        <TableColumn fx:id="percentColumn" text="Discount %" prefWidth="110.0"/>
                                        <TableColumn fx:id="amountColumn" text="Amount" prefWidth="110.0"/>
                                        <TableColumn fx:id="actorColumn" text="Applied By" prefWidth="150.0"/>
                                    </columns>
                                </TableView>
                                <HBox spacing="10.0">
                                    <children>
                                        <TextField fx:id="percentageField"
                                                   promptText="Percentage"
                                                   prefWidth="130.0"/>
                                        <TextField fx:id="reasonField"
                                                   promptText="Required reason"
                                                   prefWidth="380.0"/>
                                        <Button text="Apply Discount"
                                                styleClass="primary-button"
                                                onAction="#applyDiscount"/>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                        <VBox spacing="8.0" styleClass="card">
                            <children>
                                <Label text="Discount Audit History"
                                       styleClass="section-title"/>
                                <TableView fx:id="historyTable"
                                           prefHeight="230.0"
                                           columnResizePolicy="CONSTRAINED_RESIZE_POLICY">
                                    <columns>
                                        <TableColumn fx:id="historyDateColumn" text="Date" prefWidth="170.0"/>
                                        <TableColumn fx:id="historyPercentColumn" text="Percent" prefWidth="90.0"/>
                                        <TableColumn fx:id="historyAmountColumn" text="Amount" prefWidth="100.0"/>
                                        <TableColumn fx:id="historyActorColumn" text="Actor / Role" prefWidth="170.0"/>
                                        <TableColumn fx:id="historyReasonColumn" text="Reason" prefWidth="330.0"/>
                                    </columns>
                                </TableView>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
