<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1100.0"
            stylesheets="@../../css/app.css"
            fx:controller="com.hotelreservation.controller.admin.FeedbackManagementController"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1">
    <top>
        <VBox spacing="5.0" styleClass="header">
            <children>
                <Label text="Feedback Management" styleClass="header-title"/>
                <Label text="Checked-out guest feedback, sentiment filters, and CSV summaries"
                       styleClass="header-subtitle"/>
            </children>
        </VBox>
    </top>
    <left><fx:include source="AdminSidebar.fxml"/></left>
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER">
            <content>
                <VBox spacing="16.0" style="-fx-padding: 24;">
                    <children>
                        <VBox spacing="10.0" styleClass="card">
                            <children>
                                <HBox spacing="9.0">
                                    <children>
                                        <TextField fx:id="guestFilter"
                                                   promptText="Guest, email, or phone"
                                                   prefWidth="250.0"
                                                   onAction="#searchFeedback"/>
                                        <ComboBox fx:id="ratingFilter"
                                                  promptText="Rating"
                                                  prefWidth="105.0"/>
                                        <ComboBox fx:id="sentimentFilter"
                                                  promptText="Sentiment"
                                                  prefWidth="150.0"/>
                                        <DatePicker fx:id="fromPicker"
                                                    promptText="From"
                                                    prefWidth="135.0"/>
                                        <DatePicker fx:id="toPicker"
                                                    promptText="To"
                                                    prefWidth="135.0"/>
                                        <Button text="Search"
                                                prefWidth="135.0"
                                                styleClass="primary-button"
                                                onAction="#searchFeedback"/>
                                        <Button text="Clear"
                                                prefWidth="135.0"
                                                styleClass="secondary-button"
                                                onAction="#clearFilters"/>
                                    </children>
                                </HBox>
                                <HBox spacing="12.0" alignment="CENTER_LEFT">
                                    <children>
                                        <Label fx:id="summaryLabel"
                                               text="0 feedback entries"
                                               wrapText="true"/>
                                        <Button text="Export CSV"
                                                styleClass="primary-button"
                                                onAction="#exportCsv"/>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <VBox spacing="8.0" styleClass="card">
                            <children>
                                <TableView fx:id="feedbackTable"
                                           prefHeight="500.0">
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                    <columns>
                                        <TableColumn fx:id="reservationColumn" text="Reservation" prefWidth="110.0"/>
                                        <TableColumn fx:id="guestColumn" text="Guest" prefWidth="160.0"/>
                                        <TableColumn fx:id="ratingColumn" text="Rating" prefWidth="75.0"/>
                                        <TableColumn fx:id="commentColumn" text="Comment" prefWidth="330.0"/>
                                        <TableColumn fx:id="sentimentColumn" text="Sentiment" prefWidth="130.0"/>
                                        <TableColumn fx:id="dateColumn" text="Submitted" prefWidth="170.0"/>
                                    </columns>
                                </TableView>
                                <HBox spacing="14.0" alignment="CENTER_RIGHT">
                                    <children>
                                        <Label fx:id="paginationResultLabel"
                                               text="0 feedback entries"
                                               style="-fx-text-fill: #6b7280;"/>
                                        <Button fx:id="previousPageButton"
                                                text="Previous"
                                                prefWidth="100.0"
                                                styleClass="secondary-button"
                                                onAction="#previousPage"/>
                                        <Label fx:id="pageLabel"
                                               text="Page 1 of 1"
                                               style="-fx-font-weight: bold;"/>
                                        <Button fx:id="nextPageButton"
                                                text="Next"
                                                prefWidth="100.0"
                                                styleClass="secondary-button"
                                                onAction="#nextPage"/>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
