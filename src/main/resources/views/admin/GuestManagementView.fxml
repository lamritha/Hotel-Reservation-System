<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1100.0"
            stylesheets="@../../css/app.css"
            fx:controller="com.hotelreservation.controller.admin.GuestManagementController"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1">
    <top>
        <VBox spacing="5.0" styleClass="header">
            <children>
                <Label text="Guest Management" styleClass="header-title"/>
                <Label text="Search persisted guest profiles and enroll loyalty members"
                       styleClass="header-subtitle"/>
            </children>
        </VBox>
    </top>
    <left><fx:include source="AdminSidebar.fxml"/></left>
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER">
            <content>
                <VBox spacing="18.0" style="-fx-padding: 26;">
                    <children>
                        <HBox spacing="10.0" styleClass="card">
                            <children>
                                <TextField fx:id="searchField"
                                           promptText="Name, email, or phone"
                                           prefWidth="420.0"
                                           onAction="#searchGuests"/>
                                <Button text="Search"
                                        styleClass="primary-button"
                                        onAction="#searchGuests"/>
                                <Button text="Clear"
                                        styleClass="secondary-button"
                                        onAction="#clearSearch"/>
                                <Label fx:id="resultLabel" text="0 guest(s)"/>
                            </children>
                        </HBox>
                        <VBox spacing="10.0" styleClass="card">
                            <children>
                                <TableView fx:id="guestTable"
                                           prefHeight="410.0"
                                           columnResizePolicy="CONSTRAINED_RESIZE_POLICY">
                                    <columns>
                                        <TableColumn fx:id="nameColumn"
                                                     text="Guest"
                                                     prefWidth="180.0"/>
                                        <TableColumn fx:id="emailColumn"
                                                     text="Email"
                                                     prefWidth="240.0"/>
                                        <TableColumn fx:id="phoneColumn"
                                                     text="Phone"
                                                     prefWidth="150.0"/>
                                        <TableColumn fx:id="addressColumn"
                                                     text="Address"
                                                     prefWidth="310.0"/>
                                    </columns>
                                </TableView>
                                <HBox spacing="14.0" alignment="CENTER_RIGHT">
                                    <children>
                                        <Button fx:id="previousPageButton"
                                                text="Previous"
                                                prefWidth="100.0"
                                                styleClass="secondary-button"
                                                onAction="#previousPage"/>
                                        <Label fx:id="pageLabel"
                                               text="Page 1 of 1"
                                               style="-fx-font-weight: bold;"/>
                                        <Button fx:id="nextPageButton"
                                                text="Next"
                                                prefWidth="100.0"
                                                styleClass="secondary-button"
                                                onAction="#nextPage"/>
                                    </children>
                                </HBox>
                                <HBox spacing="12.0" alignment="CENTER_LEFT">
                                    <children>
                                        <Label fx:id="selectedGuestLabel"
                                               text="No guest selected"/>
                                        <Button fx:id="enrollButton"
                                                text="Enroll in Loyalty"
                                                styleClass="primary-button"
                                                onAction="#enrollSelectedGuest"/>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
