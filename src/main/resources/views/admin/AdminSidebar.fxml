<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="8.0" prefWidth="220.0"
      style="-fx-background-color: #111827; -fx-padding: 20;"
      fx:controller="com.hotelreservation.controller.admin.AdminNavigationController"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <Label text="Admin Menu"
               style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"/>
        <Button fx:id="dashboardButton"
                text="Dashboard" prefWidth="180.0"
                onAction="#openDashboard"
                style="-fx-background-color: transparent; -fx-text-fill: #e5e7eb;"/>
        <Button fx:id="reservationsButton"
                text="Reservations" prefWidth="180.0"
                onAction="#openReservations"
                style="-fx-background-color: transparent; -fx-text-fill: #e5e7eb;"/>
        <Button fx:id="roomsButton"
                text="Rooms" prefWidth="180.0"
                onAction="#openRooms"
                style="-fx-background-color: transparent; -fx-text-fill: #e5e7eb;"/>
        <Button fx:id="guestsButton"
                text="Guests" prefWidth="180.0"
                onAction="#openGuests"
                style="-fx-background-color: transparent; -fx-text-fill: #e5e7eb;"/>
        <Button fx:id="billingButton"
                text="Billing &amp; Payments" prefWidth="180.0"
                onAction="#openBillingPayments"
                style="-fx-background-color: transparent; -fx-text-fill: #e5e7eb;"/>
        <Button fx:id="discountsButton"
                text="Discounts" prefWidth="180.0"
                onAction="#openDiscounts"
                style="-fx-background-color: transparent; -fx-text-fill: #e5e7eb;"/>
        <Button fx:id="loyaltyButton"
                text="Loyalty" prefWidth="180.0"
                onAction="#openLoyalty"
                style="-fx-background-color: transparent; -fx-text-fill: #e5e7eb;"/>
        <Button fx:id="waitlistButton"
                text="Waitlist" prefWidth="180.0"
                onAction="#openWaitlist"
                style="-fx-background-color: transparent; -fx-text-fill: #e5e7eb;"/>
        <Button fx:id="feedbackButton"
                text="Feedback" prefWidth="180.0"
                onAction="#openFeedback"
                style="-fx-background-color: transparent; -fx-text-fill: #e5e7eb;"/>
        <Button fx:id="reportsButton"
                text="Reports" prefWidth="180.0"
                onAction="#openReports"
                style="-fx-background-color: transparent; -fx-text-fill: #e5e7eb;"/>
        <Button fx:id="notificationsButton"
                text="Notifications" prefWidth="180.0"
                onAction="#openNotifications"
                style="-fx-background-color: transparent; -fx-text-fill: #e5e7eb;"/>
        <Button text="Logout" prefWidth="180.0"
                onAction="#logout"
                style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-font-weight: bold;"/>
    </children>
</VBox>
