<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1100.0"
            stylesheets="@../../css/app.css"
            fx:controller="com.hotelreservation.controller.admin.ReportsController"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1">
    <top>
        <VBox spacing="5.0" styleClass="header">
            <children>
                <Label text="Tabular Reports" styleClass="header-title"/>
                <Label text="Revenue, occupancy, and administrative activity exports"
                       styleClass="header-subtitle"/>
            </children>
        </VBox>
    </top>
    <left><fx:include source="AdminSidebar.fxml"/></left>
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER">
            <content>
                <VBox spacing="16.0" style="-fx-padding: 24;">
                    <children>
                        <VBox spacing="10.0" styleClass="card">
                            <children>
                                <HBox spacing="9.0">
                                    <children>
                                        <ComboBox fx:id="reportTypeComboBox"
                                                  prefWidth="170.0"/>
                                        <ComboBox fx:id="periodComboBox"
                                                  prefWidth="125.0"/>
                                        <ComboBox fx:id="roomTypeComboBox"
                                                  promptText="All room types"
                                                  prefWidth="150.0"/>
                                        <DatePicker fx:id="fromPicker"
                                                    prefWidth="135.0"/>
                                        <DatePicker fx:id="toPicker"
                                                    prefWidth="135.0"/>
                                        <Button text="Generate"
                                                styleClass="primary-button"
                                                onAction="#generateReport"/>
                                    </children>
                                </HBox>
                                <HBox spacing="9.0" alignment="CENTER_LEFT">
                                    <children>
                                        <Label fx:id="statusLabel" text="No report generated"/>
                                        <Button text="Export CSV"
                                                styleClass="primary-button"
                                                onAction="#exportCsv"/>
                                        <Button text="Export PDF"
                                                styleClass="secondary-button"
                                                onAction="#exportPdf"/>
                                        <Button text="Export TXT"
                                                styleClass="secondary-button"
                                                onAction="#exportTxt"/>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <VBox spacing="8.0" styleClass="card">
                            <children>
                                <TableView fx:id="revenueTable"
                                           prefHeight="500.0">
                                    <columns>
                                        <TableColumn fx:id="revenuePeriodColumn" text="Period" prefWidth="190.0"/>
                                        <TableColumn fx:id="reservationCountColumn" text="Reservations" prefWidth="115.0"/>
                                        <TableColumn fx:id="subtotalColumn" text="Subtotal" prefWidth="115.0"/>
                                        <TableColumn fx:id="taxColumn" text="Tax" prefWidth="100.0"/>
                                        <TableColumn fx:id="discountsColumn" text="Discounts" prefWidth="110.0"/>
                                        <TableColumn fx:id="revenueTotalColumn" text="Total" prefWidth="120.0"/>
                                    </columns>
                                </TableView>

                                <TableView fx:id="occupancyTable"
                                           prefHeight="500.0"
                                           visible="false"
                                           managed="false">
                                    <columns>
                                        <TableColumn fx:id="occupancyDateColumn" text="Period" prefWidth="240.0"/>
                                        <TableColumn fx:id="availableColumn" text="Rooms Available" prefWidth="180.0"/>
                                        <TableColumn fx:id="occupiedColumn" text="Rooms Occupied" prefWidth="180.0"/>
                                        <TableColumn fx:id="percentageColumn" text="Occupancy %" prefWidth="180.0"/>
                                    </columns>
                                </TableView>

                                <TableView fx:id="activityTable"
                                           prefHeight="500.0"
                                           visible="false"
                                           managed="false">
                                    <columns>
                                        <TableColumn fx:id="activityTimeColumn" text="Timestamp" prefWidth="170.0"/>
                                        <TableColumn fx:id="activityActorColumn" text="Actor" prefWidth="100.0"/>
                                        <TableColumn fx:id="activityActionColumn" text="Action" prefWidth="170.0"/>
                                        <TableColumn fx:id="activityEntityColumn" text="Entity" prefWidth="110.0"/>
                                        <TableColumn fx:id="activityIdColumn" text="ID" prefWidth="85.0"/>
                                        <TableColumn fx:id="activityMessageColumn" text="Message" prefWidth="310.0"/>
                                    </columns>
                                </TableView>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
