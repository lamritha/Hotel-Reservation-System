<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1100.0"
            stylesheets="@../../css/app.css"
            fx:controller="com.hotelreservation.controller.admin.BillingPaymentController"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1">
    <top>
        <VBox spacing="5.0" styleClass="header">
            <children>
                <Label text="Billing &amp; Payments" styleClass="header-title"/>
                <Label text="Deposits, partial payments, loyalty redemption, refunds, check-in and checkout"
                       styleClass="header-subtitle"/>
            </children>
        </VBox>
    </top>
    <left><fx:include source="AdminSidebar.fxml"/></left>
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER">
            <content>
                <VBox spacing="16.0" style="-fx-padding: 24;">
                    <children>
                        <HBox spacing="10.0" styleClass="card">
                            <children>
                                <TextField fx:id="searchField"
                                           promptText="Reservation, guest, email, or phone"
                                           prefWidth="420.0"
                                           onAction="#searchBills"/>
                                <Button text="Search"
                                        styleClass="primary-button"
                                        onAction="#searchBills"/>
                                <Button text="Clear"
                                        styleClass="secondary-button"
                                        onAction="#clearSearch"/>
                                <Label fx:id="resultLabel" text="0 bill(s)"/>
                            </children>
                        </HBox>

                        <VBox spacing="8.0" styleClass="card">
                            <children>
                                <TableView fx:id="billingTable"
                                           prefHeight="250.0">
                                    <columns>
                                        <TableColumn fx:id="reservationColumn" text="Reservation" prefWidth="110.0"/>
                                        <TableColumn fx:id="guestColumn" text="Guest" prefWidth="180.0"/>
                                        <TableColumn fx:id="reservationStatusColumn" text="Status" prefWidth="120.0"/>
                                        <TableColumn fx:id="totalColumn" text="Bill Total" prefWidth="110.0"/>
                                        <TableColumn fx:id="discountColumn" text="Discount" prefWidth="100.0"/>
                                        <TableColumn fx:id="paidColumn" text="Paid" prefWidth="100.0"/>
                                        <TableColumn fx:id="outstandingColumn" text="Outstanding" prefWidth="120.0"/>
                                    </columns>
                                </TableView>
                            </children>
                        </VBox>

                        <VBox spacing="10.0" styleClass="card">
                            <children>
                                <Label fx:id="selectedBillLabel"
                                       text="Select a billing record."
                                       styleClass="section-title"/>
                                <GridPane hgap="12.0" vgap="10.0">
                                    <children>
                                        <Label text="Amount" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                                        <TextField fx:id="amountField"
                                                   promptText="0.00"
                                                   prefWidth="150.0"
                                                   GridPane.rowIndex="1"
                                                   GridPane.columnIndex="0"/>
                                        <Label text="Method" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                                        <ComboBox fx:id="methodComboBox"
                                                  prefWidth="170.0"
                                                  GridPane.rowIndex="1"
                                                  GridPane.columnIndex="1"/>
                                        <Label text="Payment Type" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                                        <ComboBox fx:id="paymentTypeComboBox"
                                                  prefWidth="190.0"
                                                  GridPane.rowIndex="1"
                                                  GridPane.columnIndex="2"/>
                                        <Label text="Note" GridPane.rowIndex="0" GridPane.columnIndex="3"/>
                                        <TextField fx:id="noteField"
                                                   promptText="Optional transaction note"
                                                   prefWidth="280.0"
                                                   GridPane.rowIndex="1"
                                                   GridPane.columnIndex="3"/>
                                    </children>
                                </GridPane>
                                <HBox spacing="9.0">
                                    <children>
                                        <Button text="Process Payment"
                                                styleClass="primary-button"
                                                onAction="#processPayment"/>
                                        <Button text="Refund"
                                                styleClass="secondary-button"
                                                onAction="#processRefund"/>
                                        <Button text="Check In"
                                                styleClass="secondary-button"
                                                onAction="#checkIn"/>
                                        <Button text="Check Out"
                                                styleClass="secondary-button"
                                                onAction="#checkOut"/>
                                        <Button text="Export Final Bill PDF"
                                                styleClass="secondary-button"
                                                onAction="#exportFinalBill"/>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <VBox spacing="8.0" styleClass="card">
                            <children>
                                <Label text="Payment History" styleClass="section-title"/>
                                <TableView fx:id="paymentTable"
                                           prefHeight="230.0">
                                    <columns>
                                        <TableColumn fx:id="paymentDateColumn" text="Date" prefWidth="180.0"/>
                                        <TableColumn fx:id="paymentMethodColumn" text="Method" prefWidth="120.0"/>
                                        <TableColumn fx:id="paymentTypeColumn" text="Type" prefWidth="170.0"/>
                                        <TableColumn fx:id="paymentAmountColumn" text="Amount" prefWidth="110.0"/>
                                        <TableColumn fx:id="paymentNoteColumn" text="Note" prefWidth="300.0"/>
                                    </columns>
                                </TableView>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
